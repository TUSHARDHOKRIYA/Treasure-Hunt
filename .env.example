# Supabase → Project Settings → Database → Connection string
# Pooled (Transaction pooler, port 6543) — used by the app on Vercel:
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / Session pooler (port 5432) — used by prisma db push:
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Long random string used to sign login cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Organiser login for /admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Volunteer PIN required to confirm team attendance (leave empty to disable)
ATTENDANCE_PIN="2468"

# When the team clock starts: "login" or "attendance"
TIMER_START="attendance"

# Tell teams which QR station (A/B/C) to scan at each track: "true" or "false"
SHOW_STATION="true"

# Seconds a team must wait after a wrong answer
WRONG_ANSWER_COOLDOWN="5"

# Public base URL printed into QR codes (your deployed URL, or your laptop's LAN IP for testing)
PUBLIC_BASE_URL="http://localhost:3000"
